<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteRule ^(build|css|js|images|fonts|vendor)/(.*)$ public/$1/$2 [L]
    RewriteRule ^(favicon\.ico|robots\.txt|sw\.js)$ public/$1 [L]

    # public/media is a symlink to storage/app/public (see config/filesystems.php).
    # Named "media", not "storage" — on the production layout the real Laravel
    # storage/ directory already sits at that name at the top level, so
    # "storage" isn't free to reuse as the symlink name there.
    RewriteCond %{DOCUMENT_ROOT}/public/media -d
    RewriteRule ^media/(.*)$ public/media/$1 [L]

    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ index.php [L]
</IfModule>
