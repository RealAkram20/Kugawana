<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteRule ^(build|css|js|images|fonts|vendor)/(.*)$ public/$1/$2 [L]
    RewriteRule ^(favicon\.ico|robots\.txt|sw\.js)$ public/$1 [L]

    # Only take this fast path where public/storage actually exists (a real
    # symlink, e.g. local dev). Hosts that disable PHP's symlink() function
    # (e.g. Hostinger shared hosting) never get this file, so the request
    # falls through to index.php, where a dedicated route in web.php serves
    # the public disk directly.
    RewriteCond %{DOCUMENT_ROOT}/public/storage -d
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ index.php [L]
</IfModule>
